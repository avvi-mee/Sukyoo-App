# Continuous Native Generation: ios/ and android/ are OUTPUT, regenerated by
# `expo prebuild` from app.config.ts. Committing them would both add tens of
# thousands of lines and, worse, make hand-edits there look durable when the
# next prebuild silently deletes them.
ios/
android/

# Next.js build output for apps/admin.
.next/

# Credentials, not config. Every one of these is a live key.
google-services.json
GoogleService-Info.plist
google-play-service-account.json
*.p8
*.p12
*.keystore
*.jks

.vercel
.env*
